# APP
PORT=8080
# Secret key required in X-Api-Key header for all /api/v1 requests
API_KEY=change-me-to-a-long-random-secret
# Comma-separated list of allowed CORS origins (defaults to localhost values if omitted)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# DB
DB_HOST=localhost
DB_PORT=5432
DB_USER=myadmin
DB_PASSWORD=mypassword
DB_NAME=brandkitdb
DB_DATABASE=brandkitdb
DB_SSL=false

# AWS
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=""
AWS_CLOUDFRONT_DOMAIN_NAME=""
