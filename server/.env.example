# APP
PORT=8080
# Secret key required in X-Api-Key header for all /api/v1 requests (use 24+ random characters)
API_KEY=change-me-to-a-long-random-secret
# Comma-separated list of allowed CORS origins (defaults to localhost values if omitted)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Number of reverse proxies in front of the app (1 behind CloudFront). Leave unset when exposed directly.
# TRUST_PROXY=1
# Maximum upload size enforced by the presigned POST policy (default 10 MiB)
# MAX_UPLOAD_BYTES=10485760

# DB
DB_HOST=localhost
DB_PORT=5432
DB_USER=myadmin
DB_PASSWORD=mypassword
DB_DATABASE=brandkitdb
DB_SSL=false
# Required to verify the server certificate when DB_SSL=true (RDS global bundle is in the repo)
# DB_SSL_CA_PATH=../infrastructure/certs/rds-global-bundle.pem
# DB_POOL_MAX=10

# AWS
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=""
AWS_CLOUDFRONT_DOMAIN_NAME=""
