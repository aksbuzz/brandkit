# Base URL of the API. With the Terraform stack this is the `api_base_url` output (CloudFront, HTTPS).
VITE_API_BASE_URL="https://<distribution>.cloudfront.net/api/v1"

# Optional. Sent as X-Api-Key. WARNING: VITE_* values are embedded in the public JavaScript bundle,
# so only use this for an internal deployment (see docs/adr/0010-shared-api-key-authentication.md).
# VITE_API_KEY=""

# Optional client-side upload limit in MB (the server enforces its own limit). Default 10.
# VITE_MAX_UPLOAD_MB=10
